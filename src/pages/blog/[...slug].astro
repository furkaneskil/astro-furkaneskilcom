---
import { type CollectionEntry, getCollection } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { render } from 'astro:content';
import { normalizeSlug } from '../../utils/blog';
import SectionHeading from '../../components/article/SectionHeading.astro';
import Trivia from '../../components/article/Trivia.astro';
import Quote from '../../components/article/Quote.astro';
import DosBlock from '../../components/article/DosBlock.astro';
import PixelImage from '../../components/article/PixelImage.astro';
import FigureImage from '../../components/article/FigureImage.astro';
import References from '../../components/article/References.astro';
import FootnoteRef from '../../components/article/FootnoteRef.astro';

const mdxComponents = {
	SectionHeading,
	Trivia,
	Quote,
	DosBlock,
	PixelImage,
	FigureImage,
	References,
	FootnoteRef,
};

export async function getStaticPaths() {
	const posts = await getCollection('blog', ({ data }) => import.meta.env.DEV || !data.draft);
	return posts.map((post) => ({
		params: { slug: normalizeSlug(post.id) },
		props: post,
	}));
}

type Props = CollectionEntry<'blog'>;

const post = Astro.props;
const { Content } = await render(post);
---

<ArticleLayout {...post.data}>
	<Content components={mdxComponents} />
</ArticleLayout>

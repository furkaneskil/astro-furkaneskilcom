---
import HomeLayout from '../layouts/HomeLayout.astro';
import SectionTitle from '../components/SectionTitle.astro';
import ArticleList from '../components/ArticleList.astro';
import { SITE_PAGE_TITLE, SITE_DESCRIPTION } from '../consts';
import { ABOUT_PARAGRAPHS } from '../data/site';
import { SECTIONS, SECTION_KEYS } from '../config/sections';
import { getPostsBySection } from '../utils/blog';

const postsBySection = await getPostsBySection();
const sortedSections = SECTION_KEYS
	.map((key) => ({ key, ...SECTIONS[key] }))
	.sort((a, b) => a.order - b.order);
---

<HomeLayout title={SITE_PAGE_TITLE} description={SITE_DESCRIPTION}>
	<SectionTitle>About</SectionTitle>
	{ABOUT_PARAGRAPHS.map((paragraph) => <p>{paragraph}</p>)}

	{
		sortedSections.map(({ key, title }) => {
			const posts = postsBySection[key];
			if (posts.length === 0) return null;

			return (
				<>
					<SectionTitle>{title}</SectionTitle>
					<ArticleList posts={posts} />
				</>
			);
		})
	}
</HomeLayout>

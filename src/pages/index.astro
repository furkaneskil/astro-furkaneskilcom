---
import HomeLayout from '../layouts/HomeLayout.astro';
import ArticleList from '../components/ArticleList.astro';
import { SITE_PAGE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getPublishedPosts } from '../utils/blog';

const posts = await getPublishedPosts();
---

<HomeLayout title={SITE_PAGE_TITLE} description={SITE_DESCRIPTION} variant="portfolio">
	<div class="portfolio-shell">
		<div class="artwork-column" aria-hidden="true">
			<div class="mercury-primary">
				<div class="mercury-artwork"></div>
			</div>
			<div class="mercury-afterimage">
				<div class="mercury-afterimage-ink"></div>
			</div>
		</div>

		<section class="editorial-column" aria-label="Professional profile">
			<article class="homepage-content">
				<p class="professional-line">Independent Business Development Consultant</p>
				<h1><span>Business development for</span><span>software and IT service companies.</span></h1>
				<p class="lead">I work directly with founders and commercial teams on market and customer research, target-account development, outbound prospecting, opportunity qualification, and pipeline support.</p>

				{posts.length > 0 && (
					<div class="work-summary">
						<p class="content-label">Work</p>
						<ArticleList posts={posts} />
					</div>
				)}

				<div class="contact-summary">
					<h2>Let’s talk.</h2>
					<p>Open to opportunities, collaborations, and new connections.</p>
				</div>
			</article>
		</section>
	</div>
</HomeLayout>

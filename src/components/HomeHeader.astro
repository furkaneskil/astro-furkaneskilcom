---
import { AUTHOR, SITE_TITLE_DISPLAY, RESUME_PDF } from '../consts';
---

<header class="site-header">
	<div class="site-header-inner">
		<a href="/" class="site-mark">{SITE_TITLE_DISPLAY}</a>
		<div class="header-right">
			<a href={`mailto:${AUTHOR.email}`} class="header-link">Email <span aria-hidden="true">↗</span></a>
			<a href={AUTHOR.linkedin} class="header-link" target="_blank" rel="noopener noreferrer">LinkedIn <span aria-hidden="true">↗</span></a>
			<a href={RESUME_PDF} class="resume-link" target="_blank" rel="noopener noreferrer">Resume <span aria-hidden="true">↗</span></a>
		</div>
	</div>
</header>

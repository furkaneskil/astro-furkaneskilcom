---
import { SITE_TITLE_DISPLAY, AUTHOR, RESUME_PDF } from '../consts';
---

<header class="header-bar">
	<div class="site-branding">
		<a href="/" class="site-title">{SITE_TITLE_DISPLAY}</a>
	</div>
	<div class="header-actions">
		<a href={RESUME_PDF} class="header-nav-link">Resume</a>

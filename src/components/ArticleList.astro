---
import type { CollectionEntry } from 'astro:content';
import { normalizeSlug } from '../utils/blog';
import { SECTIONS } from '../config/sections';

interface Props {
	posts: CollectionEntry<'blog'>[];
}

const { posts } = Astro.props;
---

<ol class="work-list">
	{
		posts.map((post) => (
			<li>
				<time datetime={post.data.pubDate.toISOString()}>{post.data.pubDate.getFullYear()}</time>
				<a href={`/blog/${normalizeSlug(post.id)}/`}>{post.data.title}</a>
				<span>{SECTIONS[post.data.section].title.replace(/s$/, '')}</span>
			</li>
		))
	}
</ol>

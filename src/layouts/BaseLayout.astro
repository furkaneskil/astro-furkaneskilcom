---
import BaseHead from '../components/BaseHead.astro';

interface Props {
	title: string;
	description: string;
	type?: 'website' | 'article';
	pubDate?: Date;
	updatedDate?: Date;
}

const { title, description, type, pubDate, updatedDate } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={title}
			description={description}
			type={type}
			pubDate={pubDate}
			updatedDate={updatedDate}
		/>
	</head>
	<body class="home">
		<slot name="header" />
		<main>
			<slot />
		</main>
		<slot name="footer" />
	</body>
</html>

---
import BaseLayout from './BaseLayout.astro';
import HomeHeader from '../components/HomeHeader.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import '../styles/home.css';

interface Props {
	title?: string;
	description?: string;
	type?: 'website' | 'article';
	pubDate?: Date;
	updatedDate?: Date;
	variant?: 'portfolio' | 'article';
}

const {
	title = SITE_TITLE,
	description = SITE_DESCRIPTION,
	type = 'website',
	pubDate,
	updatedDate,
	variant = 'article',
} = Astro.props;
---

<BaseLayout
	title={title}
	description={description}
	type={type}
	pubDate={pubDate}
	updatedDate={updatedDate}
	bodyClass={variant === 'portfolio' ? 'portfolio-page' : 'article-page'}
>
	<HomeHeader slot="header" />
	<slot />
</BaseLayout>
